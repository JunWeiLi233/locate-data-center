# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
build/
dist/

# Data and run outputs (large; reproducible from code + manifests)
data/raw/
data/interim/
data/processed/*
!data/processed/.gitkeep
!data/processed/*.json
runs/*
!runs/.gitkeep
!runs/README.md

# Secrets
.env
*.key

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local workspace tools
.claude/
.omx/

# Scratch belongs in .pytest-work/<task>/ (see .pytest-work/README.md). Root-level .tmp-*
# is the retired scratch convention; it stays ignored in case an old recorded command recreates it.
.pytest-work/*
!.pytest-work/README.md
.tmp-*

# Isolated county-model runtime and public frontend configuration.
backend/**/data/raw
backend/**/data/processed
backend/**/outputs/
**/.env.*
!**/.env.example
**/node_modules/
**/.tmp/
**/*.tsbuildinfo
**/test-results/
**/playwright-report/
**/.venv
