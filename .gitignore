# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
build/
dist/

# Data and run outputs (large; reproducible from code + manifests)
data/raw/
data/interim/
data/processed/*
!data/processed/.gitkeep
!data/processed/*.json
runs/*
!runs/.gitkeep

# Secrets
.env
*.key

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local workspace tools and verification scratch files
.claude/
.omx/
.pytest-work/
.tmp-*/
.tmp-*.py
.tmp-*.html
.tmp-*.xml

# Isolated county-backend runtime artifacts and local frontend settings.
backend/**/data/raw
backend/**/data/processed
backend/**/outputs/
**/.env.*
!**/.env.example
**/node_modules/
**/.tmp/
**/*.tsbuildinfo
**/test-results/
**/playwright-report/
# Ignore reused runtime roots even if they are symlinks rather than directories.
**/.venv
