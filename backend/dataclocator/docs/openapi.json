        "title": "Constraint",
        "description": "Support documented screening thresholds, not inferred chance constraints."
      },
      "ConvergenceTolerances": {
        "properties": {
          "relative_objective_mean": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
