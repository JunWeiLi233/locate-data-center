VITE_USE_MOCK_DATA=false
# Keep the teammate's grid bridge by default. Set monte-carlo for the isolated county backend.
VITE_MODEL_BACKEND=grid
# County backend uses direct /runs paths (no /api prefix). Set the exact CORS origin when serving it.
VITE_MONTE_CARLO_API_URL=http://127.0.0.1:8000
# Empty uses the same-origin /api service (Vite proxies to localhost:8787).
VITE_API_BASE_URL=
# Optional replaceable MapLibre style URL; blank uses bundled Census context.
VITE_MAP_STYLE_URL=
