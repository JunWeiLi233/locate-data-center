VITE_USE_MOCK_DATA=false
# Empty uses the same-origin /api service (Vite proxies to localhost:8787).
VITE_API_BASE_URL=
# Optional replaceable MapLibre style URL; blank uses bundled Census context.
VITE_MAP_STYLE_URL=
# Model selection uses the visible Model control or /?model=county; grid is default.
# The isolated county API uses /runs directly and requires explicit frontend CORS origins.
VITE_MONTE_CARLO_API_URL=http://127.0.0.1:8000
